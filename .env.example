# memory = 재시작 시 초기화 | postgres = DB 영속화
STORAGE_MODE=memory

# --- Supabase / Render Postgres (STORAGE_MODE=postgres 일 때) ---
# Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# 또는 개별 설정
# DB_HOST=db.xxxx.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=your-password
# DB_NAME=postgres

# MVP: true면 테이블 자동 생성 (운영 전엔 migration 권장)
DB_SYNCHRONIZE=true

# 배포 URL (로그용, 선택)
# PUBLIC_URL=https://your-app.onrender.com
