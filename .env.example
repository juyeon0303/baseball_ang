# memory = 재시작 시 초기화 | postgres = DB 영속화 (권장)
STORAGE_MODE=postgres

# --- 로컬 Docker (docker compose up -d) ---
DATABASE_URL=postgresql://yagu:yagu@localhost:5432/yagu_jusik
DATABASE_SSL=false
DB_SYNCHRONIZE=true

# --- Supabase / Render (클라우드) ---
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
# DATABASE_SSL=true  (또는 URL에 supabase 포함 시 자동)

# 또는 개별 설정
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=yagu
# DB_PASS=yagu
# DB_NAME=yagu_jusik

# 배포 URL (CORS, 선택)
# PUBLIC_URL=https://your-app.onrender.com
# WEB_URL=http://localhost:5173

# 크롤링·점수판 (기본 켜짐)
# LIVE_STATS_ENABLED=true
# GAMES_SYNC_ENABLED=true
# MEME_SYNC_ENABLED=true
